# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=your_mongodb_connection_string_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Frontend (CORS)
FRONTEND_URL=http://localhost:5173

# ── Judge0 Code Execution ─────────────────────────────────────────────────────
# Option A: Use the FREE public Judge0 CE instance (no key needed, rate-limited)
#   JUDGE0_URL=https://judge0-ce.p.rapidapi.com
#   Leave JUDGE0_API_KEY empty

# Option B: Use RapidAPI hosted Judge0 (higher limits, needs key)
#   JUDGE0_URL=https://judge0-ce.p.rapidapi.com
#   JUDGE0_API_KEY=your_rapidapi_key_here

# Option C: Use your own self-hosted Judge0 (from judge0-local/)
#   JUDGE0_URL=http://localhost:2358
#   Leave JUDGE0_API_KEY empty

JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
